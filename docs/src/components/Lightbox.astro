---
/**
 * Image viewer: clicking a screenshot opens it at full size.
 *
 * It lives in a `<dialog>` because that gives for free what is costly to do by
 * hand: a top layer above everything without fighting `z-index`, focus trapped
 * inside while it is open, and closing with Escape.
 *
 * On performance, which is what drives the design. The first version blurred
 * the page behind with `backdrop-filter` and grew the image out of its
 * thumbnail. It stuttered: an animated `backdrop-filter` forces the browser to
 * rasterise the blur of the whole page on every frame, and on top of that it
 * coincided with decoding the large image.
 *
 * Here the backdrop is a flat colour —no blur— and the image comes in with a
 * fade and a minimal scale change. The only two animated properties are
 * `opacity` and `transform`, which the compositor handles without repainting
 * anything. The image is also decoded **before** the dialog opens, so there is
 * no blank frame at the start.
 *
 * In exchange for the flashy animation, the viewer gains what actually gets
 * used on a page with eight screenshots: moving from one to the next without
 * closing it.
 */
const { t } = Astro.locals
---

<dialog
	class="w-lightbox"
	aria-label={t('fp.lightbox.dialog')}
	data-zoom-label={t('fp.lightbox.zoom')}
	data-no-alt={t('fp.lightbox.noAlt')}
>
	<div class="w-lightbox__bar">
		<p class="w-lightbox__caption"></p>
		<span class="w-lightbox__counter" aria-hidden="true"></span>
		<button class="w-lightbox__close" type="button" aria-label={t('fp.lightbox.close')}>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path
					d="M18 6 6 18M6 6l12 12"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"></path>
			</svg>
		</button>
	</div>

	<div class="w-lightbox__stage">
		<button class="w-lightbox__step w-lightbox__step--prev" type="button" aria-label={t('fp.lightbox.prev')}>
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<path
					d="M15 5 8 12l7 7"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>

		<img class="w-lightbox__img" alt="" />

		<button
			class="w-lightbox__step w-lightbox__step--next"
			type="button"
			aria-label={t('fp.lightbox.next')}>
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<path
					d="m9 5 7 7-7 7"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
	</div>
</dialog>

<style>
	.w-lightbox {
		border: 0;
		padding: 0;
		background: transparent;
		max-inline-size: 100vw;
		max-block-size: 100vh;
		inline-size: 100%;
		block-size: 100%;
		overflow: hidden;
		color: #f4f4f5;
	}

	.w-lightbox:not([open]) {
		display: none;
	}

	.w-lightbox[open] {
		display: grid;
		grid-template-rows: auto 1fr;
	}

	/* Flat colour, no `backdrop-filter`: blurring the page behind is what made
	   opening stutter. */
	.w-lightbox::backdrop {
		background: rgb(9 9 11 / 0.97);
	}

	.w-lightbox__bar {
		display: flex;
		align-items: center;
		gap: var(--w-space-3);
		padding: var(--w-space-3) var(--w-space-4);
		border-block-end: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(9 9 11 / 0.6);
	}

	.w-lightbox__caption {
		margin: 0;
		flex: 1;
		min-inline-size: 0;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: #d4d4d8;
		/* A long alt text must not push the close button off screen. */
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.w-lightbox__counter {
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #a1a1aa;
		font-variant-numeric: tabular-nums;
	}

	.w-lightbox__counter:empty {
		display: none;
	}

	/* Three columns instead of arrows floating over the image: a wide
	   screenshot covered them completely and there was no way to click them.
	   This way the image never overlaps the controls. */
	.w-lightbox__stage {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		justify-items: center;
		gap: var(--w-space-3);
		min-block-size: 0;
		padding: var(--w-space-4);
	}

	.w-lightbox__img {
		max-inline-size: 100%;
		max-block-size: 100%;
		inline-size: auto;
		block-size: auto;
		object-fit: contain;
		border-radius: var(--w-radius-md);
		/* Announce what is going to change so the compositor gives it its own
		   layer from the start instead of creating one mid-animation. */
		will-change: opacity, transform;
	}

	/* A logo with a transparent background has single-colour ink and needs the
	   surface it was drawn for underneath, just like in the content: otherwise
	   the Pterodactyl one —almost white ink— disappears against the viewer's
	   backdrop. The classes are copied from the original image when it opens. */
	.w-lightbox__img.w-img-plate {
		padding: var(--w-space-6);
	}

	.w-lightbox__img.w-img-plate--light {
		background: #f4f4f5;
	}

	.w-lightbox__img.w-img-plate--dark {
		background: #17171a;
	}

	.w-lightbox__close,
	.w-lightbox__step {
		display: grid;
		place-items: center;
		border: 1px solid rgb(255 255 255 / 0.16);
		border-radius: var(--w-radius-pill);
		background: rgb(255 255 255 / 0.06);
		color: inherit;
		cursor: pointer;
	}

	.w-lightbox__close {
		inline-size: 2rem;
		block-size: 2rem;
		flex: none;
	}

	.w-lightbox__step {
		inline-size: 2.75rem;
		block-size: 2.75rem;
		flex: none;
		background: rgb(9 9 11 / 0.7);
	}

	/* With a single image the arrows are hidden, but their column stays:
	   otherwise the image would be off-centre relative to the bar above. */
	.w-lightbox__step[hidden] {
		display: block;
		visibility: hidden;
		pointer-events: none;
	}

	:is(.w-lightbox__close, .w-lightbox__step):hover {
		background: var(--w-accent-solid);
		border-color: var(--w-accent-solid);
		color: var(--w-on-accent);
	}

	:is(.w-lightbox__close, .w-lightbox__step):focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	/* The whole animation is two cheap properties and 200 ms. It is triggered
	   by adding the class, not by `[open]`, so it can be replayed when switching
	   images without closing the viewer. */
	@media (prefers-reduced-motion: no-preference) {
		.w-lightbox--entering .w-lightbox__img {
			animation: w-lightbox-img-in 0.2s ease-out;
		}

		.w-lightbox--entering .w-lightbox__bar {
			animation: w-lightbox-bar-in 0.2s ease-out;
		}
	}

	@keyframes w-lightbox-img-in {
		from {
			opacity: 0;
			transform: scale(0.97);
		}
	}

	@keyframes w-lightbox-bar-in {
		from {
			opacity: 0;
		}
	}

	@media (max-width: 50rem) {
		.w-lightbox__step {
			inline-size: 2.25rem;
			block-size: 2.25rem;
		}

		.w-lightbox__stage {
			padding: var(--w-space-2);
		}
	}
</style>

<style is:global>
	/* The button must not change how the image looks: it only makes it
	   clickable. */
	.sl-markdown-content .w-zoomable {
		display: block;
		inline-size: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}

	.sl-markdown-content .w-zoomable:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 3px;
		border-radius: var(--w-radius-md);
	}
</style>

<script is:inline>
	;(() => {
		const viewer = document.querySelector('.w-lightbox')
		if (!viewer || typeof viewer.showModal !== 'function') return

		const large = viewer.querySelector('.w-lightbox__img')
		const caption = viewer.querySelector('.w-lightbox__caption')
		const counter = viewer.querySelector('.w-lightbox__counter')
		const closeButton = viewer.querySelector('.w-lightbox__close')
		const prevButton = viewer.querySelector('.w-lightbox__step--prev')
		const nextButton = viewer.querySelector('.w-lightbox__step--next')
		const content = document.querySelector('.sl-markdown-content')
		if (!content) return

		/** Every zoomable image on the page, in document order. */
		const gallery = []
		let index = 0

		const reducedMotion = () =>
			window.matchMedia('(prefers-reduced-motion: reduce)').matches

		/**
		 * Loads an image from the gallery into the viewer.
		 *
		 * `decode()` waits until the bitmap is ready before the image is
		 * painted: without it, opening a heavy screenshot showed a gap for one
		 * or two frames. If it fails —broken format, or the browser does not
		 * implement it— we carry on, just without that guarantee.
		 */
		const show = async (n) => {
			index = (n + gallery.length) % gallery.length
			const img = gallery[index]

			large.src = img.currentSrc || img.src
			large.alt = img.alt || ''
			caption.textContent = img.alt || ''
			counter.textContent = gallery.length > 1 ? `${index + 1} / ${gallery.length}` : ''

			// The colour plate travels with the image: a light-ink logo becomes
			// invisible without it. Only the plate classes from the previous
			// image are removed; reassigning the whole `className` wiped out
			// Astro's scoping class, and all the CSS along with it.
			for (const cls of [...large.classList]) {
				if (cls.startsWith('w-img-plate')) large.classList.remove(cls)
			}
			for (const cls of img.classList) {
				if (cls.startsWith('w-img-plate')) large.classList.add(cls)
			}

			const hasSeveral = gallery.length > 1
			prevButton.hidden = !hasSeveral
			nextButton.hidden = !hasSeveral

			try {
				await large.decode()
			} catch {
				/* never mind: it gets painted whenever it can */
			}

			if (reducedMotion()) return
			// Restart the animation: remove the class, force a reflow and add
			// it back. Without the reflow the browser batches both changes and
			// does not replay it when switching images.
			viewer.classList.remove('w-lightbox--entering')
			void viewer.offsetWidth
			viewer.classList.add('w-lightbox--entering')
		}

		for (const img of content.querySelectorAll('img')) {
			// An image that is already a link is left alone: the link wins.
			if (img.closest('a') || img.closest('.w-zoomable')) continue

			const button = document.createElement('button')
			button.type = 'button'
			button.className = 'w-zoomable'
			button.setAttribute(
				'aria-label',
				viewer.dataset.zoomLabel.replace('{alt}', img.alt || viewer.dataset.noAlt)
			)
			img.parentNode.insertBefore(button, img)
			button.appendChild(img)

			const position = gallery.push(img) - 1
			button.addEventListener('click', async () => {
				await show(position)
				if (!viewer.open) viewer.showModal()
			})
		}

		if (!gallery.length) return

		closeButton.addEventListener('click', () => viewer.close())
		prevButton.addEventListener('click', () => show(index - 1))
		nextButton.addEventListener('click', () => show(index + 1))

		// Clicking outside the image closes the viewer. The `<dialog>` fills the
		// whole screen, so a click on the background reaches the dialog itself,
		// not the backdrop.
		viewer.addEventListener('click', (event) => {
			if (event.target.closest('.w-lightbox__img, .w-lightbox__bar, .w-lightbox__step')) return
			viewer.close()
		})

		viewer.addEventListener('keydown', (event) => {
			if (gallery.length < 2) return
			if (event.key === 'ArrowRight') {
				event.preventDefault()
				show(index + 1)
			} else if (event.key === 'ArrowLeft') {
				event.preventDefault()
				show(index - 1)
			}
		})

		// Release the image on close: otherwise a large screenshot stays in
		// memory and also flashes for an instant when the viewer reopens.
		viewer.addEventListener('close', () => {
			large.removeAttribute('src')
			caption.textContent = ''
			counter.textContent = ''
			viewer.classList.remove('w-lightbox--entering')
		})
	})()
</script>
