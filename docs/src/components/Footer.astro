---
/** Page footer: Starlight's pagination plus our own line with the project links. */
import { Icon } from '@astrojs/starlight/components'
import Pagination from 'virtual:starlight/components/Pagination'
// The image viewer hangs off the footer because it is the only override that
// Starlight renders on every content page, and exactly once.
import Lightbox from './Lightbox.astro'

const year = new Date().getFullYear()

const links = [
	{ label: 'GitHub', icon: 'github', href: 'https://github.com/davamudev/filebot-pro' },
	{ label: 'Reddit', icon: 'reddit', href: 'https://www.reddit.com/r/filebotpro/' },
	{ label: 'Discord', icon: 'discord', href: 'https://discord.gg/SMebtYTUmc' },
	{ label: 'filebotpro@davamu.dev', icon: 'email', href: 'mailto:filebotpro@davamu.dev' },
] as const
---

<footer class="sl-flex w-page-footer">
	<Pagination />

	<div class="w-footer">
		<span>FileBot Pro · {year}</span>
		<ul class="w-footer__social">
			{
				links.map(({ label, icon, href }) => (
					<li>
						<a
							href={href}
							{...(href.startsWith('mailto:') ? {} : { rel: 'me noopener', target: '_blank' })}
							title={label}
						>
							<Icon name={icon} size="1.125rem" />
							<span>{label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<Lightbox />

<style>
	.w-page-footer {
		flex-direction: column;
		gap: 1.5rem;
	}
</style>
