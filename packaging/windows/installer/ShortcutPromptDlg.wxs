<?xml version="1.0" encoding="utf-8"?>
<!--
    Replaces the ShortcutPromptDlg.wxs template of jpackage (resource dir override, shown with the win-shortcut-prompt option):
    desktop and Start menu shortcut checkboxes as in the JDK template, plus the ADD_TO_PATH (PATH entry) and
    EXPLORER_INTEGRATION (context menu and Send to) checkboxes of os-condition.wxf. Keep the controls and properties in
    sync with the JDK template.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Fragment>
    <UI>
      <Dialog Id="ShortcutPromptDlg" Width="370" Height="270" Title="!(loc.ShortcutPromptDlg_Title)" NoMinimize="yes">
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose the shortcuts and the Windows integration to set up." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Shortcuts and integration" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="!(loc.ShortcutPromptDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <?ifdef JpDesktopShortcutPrompt ?>
        <Control Type="CheckBox" X="20" Y="60" Width="300" Height="17" CheckBoxValue="1"
                 Id="InstallDesktopShortcut"
                 Property="JP_INSTALL_DESKTOP_SHORTCUT"
                 Text="Create a desktop shortcut"/>
        <?endif?>

        <?ifdef JpStartMenuShortcutPrompt ?>
        <Control Type="CheckBox" X="20" Y="80" Width="300" Height="17" CheckBoxValue="1"
                 Id="InstallStartMenuShortcut"
                 Property="JP_INSTALL_STARTMENU_SHORTCUT"
                 Text="Create a Start menu shortcut"/>
        <?endif?>

        <Control Type="CheckBox" X="20" Y="108" Width="300" Height="17" CheckBoxValue="1"
                 Id="AddToPath"
                 Property="ADD_TO_PATH"
                 Text="Add filebot-pro to the PATH"/>
        <Control Id="AddToPathHint" Type="Text" X="37" Y="126" Width="310" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="Run filebot-pro from any Command Prompt or PowerShell window, for scripts and automation." />

        <Control Type="CheckBox" X="20" Y="162" Width="300" Height="17" CheckBoxValue="1"
                 Id="ExplorerIntegration"
                 Property="EXPLORER_INTEGRATION"
                 Text="Add FileBot Pro to the Explorer context menu"/>
        <Control Id="ExplorerIntegrationHint" Type="Text" X="37" Y="180" Width="310" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="Open files and folders from their right-click menu or with Send to." />

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
